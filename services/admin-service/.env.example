# Copy to .env for local runs (npm run dev). Never commit .env. Values here are examples only.
AWS_PROFILE=floci
AWS_REGION=us-east-1
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4566
SCHOLARSHIPS_TABLE=Scholarships
APPLICATIONS_TABLE=Applications
REVIEWS_TABLE=Reviews
USERS_TABLE=Users
AUDIT_TABLE=AuditLog
NOTIFICATIONS_QUEUE_URL=http://localhost:4566/000000000000/notifications
JWT_SECRET_PARAM=/scholarship/jwt-secret
BREVO_KEY_PARAM=/scholarship/brevo-api-key
# Only used by infra/deploy.sh to fill SSM — real value only in your local .env
BREVO_API_KEY=
ALLOWED_DOMAINS=example-university.edu
