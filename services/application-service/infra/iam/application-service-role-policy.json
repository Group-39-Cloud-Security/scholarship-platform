{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationsReadWriteDelete",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Applications",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Applications/index/*"
      ]
    },
    {
      "Sid": "ScholarshipsReadOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Scholarships",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Scholarships/index/*"
      ]
    },
    {
      "Sid": "ApplicationPdfsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::scholarship-documents/applications/*"
    },
    {
      "Sid": "AuditLogAppendOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/AuditLog"
    },
    {
      "Sid": "ReadJwtSecretOnly",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-1:000000000000:parameter/scholarship/jwt-secret"
    },
    {
      "Sid": "ReadUserStatusForTokenCheck",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/Users"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/application-service:*"
    }
  ]
}
