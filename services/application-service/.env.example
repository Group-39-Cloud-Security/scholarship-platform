# Copy to .env for local runs (npm run dev). Never commit .env. Values here are examples only.
AWS_PROFILE=floci
AWS_REGION=us-east-1
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4566
APPLICATIONS_TABLE=Applications
SCHOLARSHIPS_TABLE=Scholarships
USERS_TABLE=Users
AUDIT_TABLE=AuditLog
DOCUMENTS_BUCKET=scholarship-documents
JWT_SECRET_PARAM=/scholarship/jwt-secret
