    {
      "name": "Open my claimed application -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('no student id or email', () => { pm.expect(data.application).to.not.have.property('studentId'); pm.expect(data.application).to.not.have.property('studentEmail'); });",
              "pm.test('has a rubric', () => pm.expect(data.scholarship.rubric.length).to.be.above(0));",
              "// build the score bodies for the next requests from this rubric",
              "const good = {}; const bad = {};",
              "data.scholarship.rubric.forEach((c, i) => { good[c.criterionId] = 8; bad[c.criterionId] = i === 0 ? 11 : 8; });",
              "pm.collectionVariables.set('goodScores', JSON.stringify({ scores: good, totalScore: 100, comment: 'Postman test' }));",
              "pm.collectionVariables.set('badScores', JSON.stringify({ scores: bad }));"
            ]
          }
        }
      ],
