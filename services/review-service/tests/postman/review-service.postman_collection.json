    {
      "name": "T-REV-01 queue without a token -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));",
              "pm.test('error code is UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/reviews/queue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reviews",
            "queue"
          ]
        }
      }
    },
