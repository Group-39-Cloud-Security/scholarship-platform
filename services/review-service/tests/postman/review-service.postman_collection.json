    {
      "name": "T-REV-03 queue as a reviewer -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test('is a list, at most 50', () => { pm.expect(list).to.be.an('array'); pm.expect(list.length).to.be.at.most(50); });",
              "pm.test('no essay or student email in the list', () => list.forEach((a) => { pm.expect(a).to.not.have.property('essay'); pm.expect(a).to.not.have.property('studentEmail'); }));",
              "pm.test('needs 2 submitted applications (run the test data first)', () => pm.expect(list.length).to.be.at.least(2));",
              "if (list.length >= 2) { pm.collectionVariables.set('appId', list[0].applicationId); pm.collectionVariables.set('appId2', list[1].applicationId); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{reviewerToken}}"
