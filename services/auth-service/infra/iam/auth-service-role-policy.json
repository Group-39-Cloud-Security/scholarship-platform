{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UsersRegisterLoginAndChangePassword",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Users",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Users/index/email-index"
      ]
    },
    {
      "Sid": "LoginAttemptsBackoff",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/LoginAttempts"
    },
    {
      "Sid": "AuditLogAppendOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/AuditLog"
    },
    {
      "Sid": "JwtSecretRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-1:000000000000:parameter/scholarship/jwt-secret"
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/auth-service:*"
    }
  ]
}
