# Copy to platform/.env (never commit). Used only by the scripts in this folder.
# The first admin (seed.sh). Its own password, never the same as SEED_TEST_PASSWORD.
SEED_ADMIN_EMAIL=admin@example-university.edu
SEED_ADMIN_PASSWORD=
# One password for every other seeded user (reviewer1-2, student1-4). It goes through the real login page, so it
# must pass the same rules as register: at least 10 characters, at most 72 bytes, not in Pwned Passwords.
SEED_TEST_PASSWORD=
CORS_ORIGINS=http://localhost:4566
ALLOWED_DOMAINS=example-university.edu
